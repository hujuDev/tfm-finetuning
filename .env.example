# Optional local settings. Copy to .env and uncomment only what you need.
# REPO_ROOT is detected automatically from the checkout.
# REPO_ROOT=/absolute/path/to/tfm-finetuning
# RESULTS_ROOT=/absolute/path/to/results
# CUDA_VISIBLE_DEVICES=0

# Experiment tracking is optional. Credentials belong in your local environment.
WANDB_MODE=disabled
# WANDB_ENTITY=your-account-or-team
# WANDB_PROJECT=tfm-finetuning
# WANDB_API_KEY=
# OPENML_API_KEY=
# HF_TOKEN=
